@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# Use the packaged finder without changing the consumer's module path.
if(NOT TARGET ibverbs::ibverbs)
  set(_hololink_roce_saved_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_package(ibverbs MODULE QUIET)
  set(CMAKE_MODULE_PATH "${_hololink_roce_saved_module_path}")
  unset(_hololink_roce_saved_module_path)
endif()
if(NOT TARGET ibverbs::ibverbs)
  set(HololinkRoce_FOUND FALSE)
  set(HololinkRoce_NOT_FOUND_MESSAGE
      "HololinkRoce transport requires libibverbs headers and library")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HololinkRoceTransportTargets.cmake")
set(HololinkRoce_transport_FOUND TRUE)
check_required_components(HololinkRoce)
