{
  "$schema": "urn:holoscan:module:v2",
  "module": {
    "name": "holoscan-sensor-bridge",
    "version": "3.0.0",
    "description": "FPGA-based sensor data bridge for low-latency capture into Holoscan pipelines. Provides Holoscan operators for camera data planes (RoCE, UDP, Linux socket, CoE), with a software emulator that allows the operators to be exercised without hardware.",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "license": "Apache-2.0",
    "language": ["C++"],
    "namespace": {
      "cpp": "hololink"
    },
    "homepage": "https://docs.nvidia.com/holoscan/sensor-bridge/getting-started/introduction",
    "platforms": ["x86_64", "aarch64"],
    "tags": [
      "sensor-bridge",
      "camera-capture",
      "csi",
      "fpga",
      "roce",
      "coe",
      "udp",
      "imx274",
      "vb1940",
      "emulator"
    ],
    "sensor_hardware": [
      "Lattice CertusPro-NX Sensor-to-Ethernet Bridge",
      "Microchip Holoscan Sensor Bridge",
      "Sony IMX274",
      "Leopard VB1940"
    ],
    "holoscan_sdk": {
      "minimum_required_version": "5.0",
      "tested_versions": ["5.0.0"]
    },
    "operator_names": [
      "ArgusIspOp",
      "CheckCrcOp",
      "ComputeCrcOp",
      "CsiToBayerOp",
      "FusaCoeCaptureOp",
      "GpuRoceTransceiverOp",
      "HsbControllerOp",
      "ImageProcessorOp",
      "LinuxReceiverOp",
      "PackedFormatConverterOp",
      "RoceReceiverOp",
      "RoceTransmitterOp",
      "SubFrameCombinerOp",
      "SubFrameVisualizerOp",
      "UdpTransmitterOp"
    ],
    "dockerfile": "docker/Dockerfile",
    "documentation": {
      "readme": "README.md"
    },
    "testing": {
      "cpp": "ctest"
    }
  }
}
